$ python3 - <<'PY'
from pathlib import Path
import re
import subprocess
readme = Path('README.md').read_text()
original = subprocess.check_output(['git', 'show', 'HEAD:README.md'], text=True)
assert readme.startswith(original), 'Existing README content must be preserved'
assert '## Acknowledgements' in readme
baseline = Path('docs/PROJECT_BASELINE.md').read_text()
references = set(re.findall(r'https://github\.com/([^/\s]+/[^/\s)]+)', baseline))
assert references == {'sealhud/sealhud_source', 'kwstudios-sweden/r3e-api'}, references
for repo in references:
    assert f'https://github.com/{repo}' in readme, repo
assert 'https://github.com/gastownhall/beads' in readme
for target in re.findall(r'\]\(([^)]+)\)', readme):
    if not target.startswith(('https://', 'http://')):
        assert Path(target).is_file(), target
assert subprocess.check_output(['git', 'diff', 'HEAD', '--', 'docs', 'src', 'package-lock.json'], text=True) == '', 'Existing source, documentation and license metadata must remain unchanged'
print('README references, local links, and existing content preservation verified')
PY
purpose=Verify documented upstream coverage, local links, and preservation of existing README content and attribution sources against HEAD.
